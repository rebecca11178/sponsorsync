# Copy this file to .env.local (git-ignored) and fill in.
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Check AI Studio for the current Flash model id.
# (gemini-2.5-* models are being retired in Oct 2026 — don't use them.)
GEMINI_MODEL=gemini-flash-latest
# YouTube Data API v3 key: Google Cloud Console → APIs & Services → enable
# "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY=
