diff --git a/src/lib/browserStore.js b/src/lib/browserStore.js
new file mode 100644
index 0000000..909ff74
--- /dev/null
+++ b/src/lib/browserStore.js
@@ -0,0 +1,28 @@
+"use client";
+import { useMemo, useSyncExternalStore } from "react";
+
+const EVENT = "sponsorsync.storage";
+export function readStored(key) {
+  try { return localStorage.getItem(key); } catch { return null; }
+}
+export function writeStored(key, value) {
+  // Report storage failures instead of falsely claiming a successful save.
+  localStorage.setItem(key, JSON.stringify(value));
+  window.dispatchEvent(new Event(EVENT));
+}
+function subscribe(callback) {
+  window.addEventListener("storage", callback);
+  window.addEventListener(EVENT, callback);
+  return () => {
+    window.removeEventListener("storage", callback);
+    window.removeEventListener(EVENT, callback);
+  };
+}
+export function useStored(key, fallback) {
+  const raw = useSyncExternalStore(subscribe, () => readStored(key), () => null);
+  const parsed = useMemo(() => { try { return raw === null ? null : JSON.parse(raw); } catch { return null; } }, [raw]);
+  return parsed ?? fallback;
+}
+export function useHydrated() {
+  return useSyncExternalStore(subscribe, () => true, () => false);
+}
diff --git a/src/lib/dealStore.js b/src/lib/dealStore.js
new file mode 100644
index 0000000..b1caa55
--- /dev/null
+++ b/src/lib/dealStore.js
@@ -0,0 +1,20 @@
+"use client";
+import { validateDeal } from "./dealTerms";
+import { deals as seed } from "./mockData";
+import { useStored, useHydrated, readStored, writeStored } from "./browserStore";
+const KEY = "sponsorsync.deals";
+export function useDeals() { return useStored(KEY, seed); }
+export function useDeal(id) {
+  const deals = useDeals();
+  const ready = useHydrated();
+  return { deal: deals.find(d => d.id === id), ready };
+}
+export function saveDeal(deal) {
+  if (!validateDeal(deal)) throw new Error("Invalid deal prices");
+  let all;
+  try { all = JSON.parse(readStored(KEY)) || seed; } catch { all = seed; }
+  writeStored(KEY, [...all.filter(d => d.id !== deal.id), deal]);
+}
+export function canAccessDeal(deal, user) {
+  return !!deal && !!user && (user.role === "sponsor" ? deal.sponsorId === user.id : deal.creatorId === user.creatorId);
+}
