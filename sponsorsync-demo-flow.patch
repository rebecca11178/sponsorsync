@@ -0,0 +1,19 @@
+import { PACKAGE_LABELS, usd } from "./format.js";
+import { validPrices } from "./validation.js";
+export const RIGHTS_LABELS = { whitelisting: "Ad whitelisting", usageExtension: "Usage extension", exclusivity: "Category exclusivity" };
+export function validateDeal(deal) {
+  return !!deal && typeof deal.sponsor === "string" && !!deal.sponsor.trim()
+    && typeof deal.creatorId === "string" && Object.hasOwn(PACKAGE_LABELS, deal.packageKey)
+    && typeof deal.basePrice === "number" && Number.isFinite(deal.basePrice) && deal.basePrice >= 0
+    && validPrices(deal.rights) && Object.keys(deal.rights).every(k => Object.hasOwn(RIGHTS_LABELS, k))
+    && Number.isFinite(deal.amount) && Math.abs(deal.amount - deal.basePrice - Object.values(deal.rights).reduce((a,b) => a+b,0)) < 0.001;
+}
+export function dealTerms(deal) {
+  return [
+    { label: "Deliverable", value: PACKAGE_LABELS[deal.packageKey] },
+    { label: "Base price", value: usd(deal.basePrice) },
+    { label: "Add-on", value: Object.entries(deal.rights).map(([k,v]) => `${RIGHTS_LABELS[k]} +${usd(v)}`).join(", ") || "None" },
+    { label: "Total", value: usd(deal.amount) },
+    { label: "Timeline", value: "To be confirmed by both parties" },
+  ];
+}
