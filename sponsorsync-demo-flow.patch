+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { parseLimit, validPrices } from '../src/lib/validation.js';
+import { validateDeal, dealTerms } from '../src/lib/dealTerms.js';
+import { deals } from '../src/lib/mockData.js';
+test('zero cap stays zero; absent cap unlimited; negative and nonfinite rejected', () => {
+  assert.equal(parseLimit(0), 0);
+  assert.equal(parseLimit(''), Infinity);
+  for (const value of [-1, 'abc', Infinity]) assert.equal(parseLimit(value), null);
+});
+test('all seed deals have consistent structured prices', () => {
+  for (const deal of deals) assert.ok(validateDeal(deal), deal.id);
+});
+test('Priya package remains $450 without invented whitelisting', () => {
+  const deal = { ...deals[1], messages: [{ text: 'The draft is ready' }] };
+  const terms = dealTerms(deal);
+  assert.equal(terms.find(t => t.label === 'Total').value, '$450');
+  assert.equal(terms.find(t => t.label === 'Add-on').value, 'None');
+});
+test('reject invalid and inconsistent quotes', () => {
+  assert.equal(validPrices({ short: -1 }), false);
+  assert.equal(validPrices({ short: NaN }), false);
+  assert.equal(validateDeal({ ...deals[0], amount: 1 }), false);
+  assert.equal(validateDeal({ ...deals[0], packageKey: 'unknown' }), false);
+});
